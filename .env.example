# Copy this file to .env and fill in your own values.
# Local MongoDB default: mongodb://127.0.0.1:27017/mentorsphere
MONGODB_URI=mongodb://127.0.0.1:27017/mentorsphere
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
EMAIL_USER=your_gmail_address
EMAIL_APP_PASSWORD=your_gmail_app_password
# Optional deployed frontend origin(s), comma-separated
CORS_ORIGIN=
# Optional; by default frontend calls same hostname on port 5000
VITE_API_URL=
